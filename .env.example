# ============================================================
# DRYLOW STUDIO — Variables d'environnement
# ============================================================
# En LOCAL : copie ce fichier en `.env` et remplis les valeurs.
# En PROD (o2switch) : colle ces clés/valeurs dans cPanel
#   → Setup Python App → ton app → Environment variables.
# NE COMMIT JAMAIS le fichier .env réel.
# ============================================================

# --- OBLIGATOIRE EN PROD ---------------------------------------
# Clé secrète Flask (sessions, cookies signés).
# Génère-en une nouvelle avec :  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_me_64_hex_chars

# Force le mode production (désactive le debug Werkzeug)
FLASK_ENV=production

# Cookie Secure (à mettre à 1 dès que le site est en HTTPS, ce qui est le cas chez o2switch)
COOKIE_SECURE=1

# --- ACCÈS AU SITE --------------------------------------------
# Mot de passe unique pour déverrouiller le site entier.
# OBLIGATOIRE — si vide, l'app refuse toute connexion.
# Choisis un mot de passe fort SANS référence évidente au thème du site
# (évite "SILVERHAND", "JOHNNY", "SAMURAI", etc. — trop devinables).
# Accès GUEST (collaborateurs — tools limités).
ACCESS_PASSWORD=

# Accès BOSS (panneau caché sur le gate — tout l'arsenal).
# OBLIGATOIRE pour pouvoir entrer en mode boss. Différent du guest, évidemment.
BOSS_PASSWORD=

# --- FFMPEG -----------------------------------------------------
# Chemin du binaire ffmpeg. Sur o2switch, à confirmer avec le support.
# Par défaut (si ffmpeg est dans le PATH) : ffmpeg
# Sur Windows en local : C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_BIN=ffmpeg

# --- BASE DE DONNÉES -------------------------------------------
# Chemin du fichier SQLite. Laisse par défaut (relatif au dossier de l'app).
# Sur o2switch, place-la hors du dossier public pour la sécu :
#   DB_PATH=/home/TONUSER/drylow_data/drylow_studio.db
DB_PATH=drylow_studio.db

# --- UPLOADS ----------------------------------------------------
MAX_UPLOAD_MB=50

# --- APIs EXTERNES ---------------------------------------------
FAL_KEY=
ELEVENLABS_API_KEY=

# --- VIDRUSH-ENGINE --------------------------------------------
# Pexels : B-roll réel (priorité #1). Clé gratuite sur pexels.com/api
PEXELS_API_KEY=
# Tous les appels LLM (Claude) passent par Fal → pas de clé Anthropic à gérer.
# Modèle pour la génération de script (titre → script long)
VIDRUSH_SCRIPT_MODEL=anthropic/claude-sonnet-4.5
# Modèle plus léger pour l'extraction de keywords (éco)
VIDRUSH_KEYWORDS_MODEL=anthropic/claude-haiku-4.5
# Voix ElevenLabs par défaut (ID de voix — ex: Rachel = 21m00Tcm4TlvDq8ikWAM)
VIDRUSH_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- STOCKAGE (optionnel) --------------------------------------
# Laisse "local" pour o2switch (le filesystem est persistant).
# Si tu passes un jour sur un cloud éphémère (Railway, Fly...) :
#   STORAGE_BACKEND=r2 et remplis les R2_* .
STORAGE_BACKEND=local
# R2_ENDPOINT_URL=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=
