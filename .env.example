# ============================================================
# EDGERUNNERS STUDIO — Variables d'environnement
# ============================================================
# En LOCAL : copie ce fichier en `.env` et remplis les valeurs.
# En PROD (o2switch) : colle ces clés/valeurs dans cPanel
#   → Setup Python App → ton app → Environment variables.
# NE COMMIT JAMAIS le fichier .env réel.
# ============================================================

# --- SESSION ET COMPTES ----------------------------------------
# Si vide, une clé de session est générée dans .env au premier lancement.
FLASK_SECRET_KEY=
FLASK_ENV=development
# 0 en local ; 1 dès que le site est servi en HTTPS.
COOKIE_SECURE=0
# Code initial à usage unique ; généré dans .env s'il manque.
# Créer le propriétaire sur l'écran initial, puis le collègue dans Réglages → Équipe.
STUDIO_BOOTSTRAP_TOKEN=
# 1 = aperçu local séparé, appels payants et publications bloqués.
STUDIO_PREVIEW=0
# File de travaux persistante (script, rendu et publications programmées).
STUDIO_WORKER_ENABLED=1

# --- PUBLICATION YOUTUBE (configuration serveur) ----------------
# Client OAuth de type Application Web. Ne pas remplir pour un simple aperçu.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base HTTPS du futur site. Callback : <base>/api/studio/youtube/callback
OAUTH_REDIRECT_BASE=

# --- FFMPEG -----------------------------------------------------
# Chemin du binaire ffmpeg. Vide = ffmpeg du PATH, sinon celui embarqué par
# `pip install imageio-ffmpeg` (rien à installer à la main sur PC).
# Sur Windows en local : C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_BIN=

# --- BASE DE DONNÉES -------------------------------------------
# Chemin du fichier SQLite. Laisse par défaut (relatif au dossier de l'app).
# Sur o2switch, place-la hors du dossier public pour la sécu :
#   DB_PATH=/home/TONUSER/drylow_data/drylow_studio.db
DB_PATH=drylow_studio.db

# --- UPLOADS ----------------------------------------------------
MAX_UPLOAD_MB=50

# --- 2D VIDEOS (POV Studio) — IA texte + images ------------------
# Proxy OpenAI-compatible (CLIProxyAPI / comptes Codex). La clé reste côté
# serveur : le navigateur ne la voit jamais.
# ex : AI_BASE_URL=https://ton-proxy.exemple/v1
AI_BASE_URL=
AI_API_KEY=
# Modèles (liste : GET <AI_BASE_URL>/models)
AI_TEXT_MODEL=gpt-5.5
AI_FAST_MODEL=gpt-5.5
# Secours texte si les comptes du modèle principal sont à court de quota (vide = aucun)
AI_TEXT_FALLBACK=gemini-3-flash
# Scripts : nombre max de passes de l'audit FacelessOS (greenlight) par script.
FOS_MAX_ROUNDS=3
AI_IMAGE_MODEL=gpt-image-2
# Images générées en parallèle (26 comptes Codex derrière le proxy → 6-10 ok)
AI_IMAGE_CONCURRENCY=6
# Dossier des projets/médias (défaut : data/pov à côté de l'app)
# POV_DATA_DIR=

# --- 2D VIDEOS — voix off ---------------------------------------
# Edge TTS (voix Microsoft) est gratuit et sans clé : rien à mettre.
# Optionnel : ElevenLabs (meilleure qualité) et/ou OpenAI TTS (vraie clé API OpenAI,
# les comptes Codex du proxy ne donnent PAS accès au TTS).
ELEVENLABS_API_KEY=
OPENAI_TTS_KEY=
# OPENAI_TTS_BASE=https://api.openai.com/v1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# --- APIs EXTERNES (autres tools) --------------------------------
FAL_KEY=

# --- VIDRUSH-ENGINE --------------------------------------------
# Pexels : B-roll réel (priorité #1). Clé gratuite sur pexels.com/api
PEXELS_API_KEY=
# Tous les appels LLM (Claude) passent par Fal → pas de clé Anthropic à gérer.
# Modèle pour la génération de script (titre → script long)
VIDRUSH_SCRIPT_MODEL=anthropic/claude-sonnet-4.5
# Modèle plus léger pour l'extraction de keywords (éco)
VIDRUSH_KEYWORDS_MODEL=anthropic/claude-haiku-4.5
# Voix ElevenLabs par défaut (ID de voix — ex: Rachel = 21m00Tcm4TlvDq8ikWAM)
VIDRUSH_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- STOCKAGE (optionnel) --------------------------------------
# Laisse "local" pour o2switch (le filesystem est persistant).
# Si tu passes un jour sur un cloud éphémère (Railway, Fly...) :
#   STORAGE_BACKEND=r2 et remplis les R2_* .
STORAGE_BACKEND=local
# R2_ENDPOINT_URL=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# Voix off Algrow (voix ElevenLabs / Stealth) — clé « algrow_... » (Professional ou Ultimate)
ALGROW_API_KEY=

# --- HISTORY DOCS (format Histoire, history_engine/) -------------
# Mêmes clés que 2D Videos (AI_*) + la voix ElevenLabs via ai33pro (Earl par défaut) :
AI33_API_KEY=
# Rendu rapide sur RunPod (pods CPU en parallèle, supprimés à la fin) : clé API RunPod. Facultatif :
# RUNPOD_PODS=8  RUNPOD_VCPU=32  RUNPOD_CPU_FLAVOR=cpu5c
RUNPOD_API_KEY=
# Node.js 18+ requis pour le rendu Remotion (npm install fait par START_STUDIO.bat).
# Tout le reste est optionnel :
# HISTORY_DATA_DIR=          # projets History (défaut : data/history)
# REMOTION_CONCURRENCY=      # images rendues en parallèle (défaut : auto)
# REMOTION_BROWSER=          # Chrome/Chromium headless à utiliser (sinon Remotion le télécharge au 1er rendu)
# WHISPER_MODEL_DIR=         # modèle faster-whisper base.en (défaut : data/models, téléchargé au 1er rendu)
# HISTORY_GEO_DIR=           # côtes/fleuves Natural Earth des cartes (défaut : data/geo, téléchargés au 1er besoin)

# --- PRODUCTION AUTOMATIQUE (production/, voir CLAUDE.md) ---------
# Webhook Discord où partent les vidéos prêtes à poster (Discord → paramètres du salon →
# Intégrations → Webhooks → Copier l'URL). Secret : jamais dans git.
DISCORD_WEBHOOK_URL=
# un salon par chaîne (sinon DISCORD_WEBHOOK_URL) : DISCORD_WEBHOOK_<CLÉ DE LA CHAÎNE>
DISCORD_WEBHOOK_SURVIVORS_ACCOUNT=
DISCORD_WEBHOOK_FRONTIER_BLOOD=
DISCORD_WEBHOOK_ODDLY_THINGS_EN=
DISCORD_WEBHOOK_ODDLY_SPECIFIC_EN=
DISCORD_WEBHOOK_ODDLY_EXPENSIVE_EN=
# Dossier de travail des productions (défaut : <repo>/work)
# STUDIO_WORK=
# Machine de rendu sur le VPS (production/vps_setup.py) : URL https + jeton affichés par le script
RENDER_WORKERS=
RENDER_WORKER_TOKEN=

# Modifications du site par Delamain : exécuteur séparé sur le même hébergement.
# Suivre DEPLOY_DELAMAIN.md ; désactivé tant que les accès ne sont pas vérifiés.
STUDIO_DEV_ENABLED=0
STUDIO_DEV_HEALTH_URL=
# Chemin npm (Node doit aussi être dans le PATH du cron).
STUDIO_DEV_NPM=npm
# Facultatif : cache npm réutilisable, paquets toujours contrôlés par le lockfile.
STUDIO_DEV_NPM_CACHE=
