# Copy to the repository root as .env. Fill private IDs from your existing API catalog.
# Never commit the completed file. The TubeForge installer creates its own private .env.
AI_BASE_URL=
AI_API_KEY=
AI_TEXT_MODEL=
AI_IMAGE_MODEL=
AI_FAST_MODEL=
ALGROW_API_KEY=
AI33_API_KEY=
TTS_MODEL=
# Optional Google Flow provider, explicitly chosen per style/project; not a fallback.
USEAPI_API_KEY=
USEAPI_IMAGE_MODEL=
# Optional installed binaries; FFmpeg is otherwise supplied by imageio-ffmpeg.
FFMPEG=
FFPROBE=
