  "events": [
    {
      "year": 1909.28,
      "text": "11 April 1909 - 66 families draw lots for plots in the dunes north of Jaffa."
    },
    {
      "year": 1909.57,
      "text": "28 July 1909 - The cornerstone of the Herzliya Hebrew Gymnasium is laid."
    },
    {
      "year": 1910.39,
      "text": "21 May 1910 - The new neighbourhood takes the name Tel Aviv."
    },
    {
      "year": 1917.3,
      "text": "1917 - Ottoman authorities expel the residents of Tel Aviv and Jaffa."
    },
    {
      "year": 1921.4,
      "text": "1921 - Tel Aviv becomes a township within the Jaffa municipality."
    },
    {
      "year": 1922.6,
      "text": "1922 - The British census counts 15,185 residents."
    },
    {
      "year": 1925.5,
      "text": "1925 - Patrick Geddes draws up the master plan for the city."
    },
    {
      "year": 1931.5,
      "text": "1931 - The census counts 46,101 residents."
    },
    {
      "year": 1934.3,
      "text": "1934 - Tel Aviv becomes an independent municipality."
    }
  ]
